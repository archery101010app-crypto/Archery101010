{
  "name": "archery-app",
  "version": "2.119.0",
  "private": true,
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/archery-core.test.ts",
    "verify:ci": "tsc --noEmit && node --test tests/archery-core.test.ts && next build",
    "deploy:test": "next build && firebase deploy -P test",
    "deploy:prod": "next build && firebase deploy -P prod",
    "bump-version": "node scripts/increment-version.js",
    "publish:play": "node scripts/publish-play-store.js",
    "generate:assets": "node scripts/generate-playstore-assets.js",
    "cap:sync": "next build && npx cap sync",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.19.0",
    "framer-motion": "^12.40.0",
    "localforage": "^1.10.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jimp": "^1.6.1",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
